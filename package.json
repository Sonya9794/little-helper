{
  "name": "little-helper",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "web:dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "web:build": "npm run typecheck && vite build",
    "test": "node --test tests/*.test.mjs && cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "check": "npm run typecheck && cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo check --locked --manifest-path src-tauri/Cargo.toml && npm test",
    "build": "tauri build --no-bundle",
    "tauri": "tauri"
  },
  "dependencies": { "@tauri-apps/api": "^2.12.0" },
  "devDependencies": { "@tauri-apps/cli": "^2.12.0", "typescript": "~5.9.3", "vite": "^7.2.0" },
  "engines": { "node": ">=22.12" }
}
